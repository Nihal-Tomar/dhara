# ==============================================================================
# DHARA — Digital Hub for Acquisition, Rehabilitation & Administration
# Environment Configuration Template
# Department of Land Resources (DoLR), Ministry of Rural Development
# Smart India Hackathon 2026 — Problem Statement 26016
#
# INSTRUCTIONS:
#   1. Copy this file to .env  →  cp .env.example .env
#   2. Replace EVERY placeholder value before running in any environment.
#   3. Never commit a .env file containing real credentials.
#   4. The .gitignore excludes .env — only .env.example is committed.
#
# PLACEHOLDER LEGEND:
#   REPLACE_WITH_* — mandatory values that must be set before the app will run
#   <value>        — example format; replace with your actual value
# ==============================================================================

# ─── APPLICATION RUNTIME ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── DATABASE (PostgreSQL + PostGIS) ──────────────────────────────────────────
POSTGRES_USER=REPLACE_WITH_DB_USER
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=dhara_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://REPLACE_WITH_DB_USER:REPLACE_WITH_STRONG_DB_PASSWORD@localhost:5432/dhara_db?schema=public

# ─── CACHE & MESSAGE QUEUE (Redis 7) ──────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# ─── OBJECT STORAGE (MinIO / S3-compatible) ───────────────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_BUCKET=dhara-documents
MINIO_USE_SSL=false

# ─── SECURITY & AUTHENTICATION (JWT) ──────────────────────────────────────────
# PRODUCTION REQUIREMENT:
#   Generate a cryptographically random secret of at least 64 characters.
#   Linux/macOS:  openssl rand -hex 64
#   Node.js:      node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
#   The application REFUSES to start in production if this value:
#     - Is missing or empty
#     - Matches this placeholder exactly
#     - Is shorter than 32 characters
#
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── INTELLIGENCE & DECISION SUPPORT SERVICE (FastAPI) ────────────────────────
INTELLIGENCE_SERVICE_URL=http://localhost:8000

# ─── FRONTEND CONFIGURATION (Next.js) ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_VERSION=1.0.0-sih

# NEXT_PUBLIC_DEMO_MODE controls the SIH evaluator demonstration features:
#   true  — Auto-logs in as District Collector for seamless demo (development/SIH only)
#   false — Requires explicit login; no default privileged session (production)
NEXT_PUBLIC_DEMO_MODE=true

# ─── OPTIONAL: AI ENHANCEMENT ─────────────────────────────────────────────────
# Uncomment and set to enable Gemini LLM-enhanced AI responses.
# Leave blank to use the deterministic rule-based engine (no external API calls).
# GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
